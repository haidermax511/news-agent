# =============================================
# مفتاح Google Gemini API (مطلوب)
# احصل عليه مجاناً من: https://aistudio.google.com/apikey
# =============================================
GEMINI_API_KEY=your_gemini_api_key_here

# =============================================
# توكنات فيسبوك / انستغرام (مطلوب لو تستخدمها)
# Long-Lived Page Access Tokens من Graph API Explorer
# https://developers.facebook.com/tools/explorer/
# =============================================
FB_TOKEN_PAGE_1=your_facebook_page_1_token
FB_TOKEN_PAGE_2=your_facebook_page_2_token
FB_TOKEN_PAGE_3=your_facebook_page_3_token
FB_TOKEN_PAGE_4=your_facebook_page_4_token

# =============================================
# توكنات تيليغرام (موصى به - أسهل وأسرع)
# أنشئ بوت من @BotFather - يأخذ دقيقة واحدة
# =============================================
TG_TOKEN_PAGE_1=your_telegram_bot_1_token
TG_TOKEN_PAGE_2=your_telegram_bot_2_token
TG_TOKEN_PAGE_3=your_telegram_bot_3_token
TG_TOKEN_PAGE_4=your_telegram_bot_4_token

# =============================================
# بوت الإشعارات الإدارية (اختياري)
# يرسل لك تنبيهات عند فشل النشر
# =============================================
TELEGRAM_ADMIN_BOT_TOKEN=your_admin_bot_token
TELEGRAM_ADMIN_CHAT_ID=your_telegram_user_id
